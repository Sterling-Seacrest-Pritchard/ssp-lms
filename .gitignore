# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# downloaded service account keys - never commit
*-key.json
vercel-gcs-key.json

# vercel
.vercel

# superpowers worktrees - full nested repo copies, never meant to be tracked
.claude/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts
